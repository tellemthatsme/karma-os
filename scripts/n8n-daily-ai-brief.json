{
  "name": "KARMA · Daily AI Research Brief",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "cronExpression": "0 20 * * *"
            }
          ]
        }
      },
      "id": "cron-0600-aest",
      "name": "Cron · 06:00 AEST (= 20:00 UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        240
      ],
      "notes": "20:00 UTC = 06:00 AEST (handles AEST and AEDT uniformly since n8n runs UTC)."
    },
    {
      "parameters": {
        "command": "cd /c/karma && python scripts/youtube_researcher.py --trending -o ai_news/CURRENT_AI_BRIEF.md 2>&1"
      },
      "id": "exec-researcher",
      "name": "Run youtube_researcher.py --trending",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        240
      ],
      "notes": "Generates ai_news/CURRENT_AI_BRIEF.md (uses cached ANTHROPIC_API_KEY via server.js proxy)."
    },
    {
      "parameters": {
        "operation": "read",
        "filePath": "ai_news/CURRENT_AI_BRIEF.md"
      },
      "id": "read-brief",
      "name": "Read the brief file",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        720,
        240
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "title",
              "value": "=🧪 AI Weekly Brief — {{ $now.format('YYYY-MM-DD') }} AEST",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "description",
              "value": "={{ $binary.data }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "color",
              "value": "5814783",
              "type": "number"
            },
            {
              "id": "a4",
              "name": "footer",
              "value": "Generated by KARMA OS · scripts/youtube_researcher.py",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "build-discord-payload",
      "name": "Build Discord payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [
        960,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_AI_BRIEF }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "@here Today's AI brief is here 👇"
            },
            {
              "name": "embeds",
              "value": "[{\"title\": {{ JSON.stringify($json.title) }}, \"description\": {{ JSON.stringify($json.description).slice(0, 4000) }}, \"color\": {{ $json.color }}, \"footer\": {\"text\": {{ JSON.stringify($json.footer) }} } }]"
            }
          ]
        },
        "options": {
          "splitIntoItems": false,
          "timeout": 30000
        }
      },
      "id": "post-discord",
      "name": "POST to Discord webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        240
      ],
      "notes": "Set DISCORD_WEBHOOK_AI_BRIEF in n8n env vars. Discord embeds cap at 4096 chars — we slice the brief to 4000 to stay under."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $env.TELEGRAM_AI_BRIEF_CHAT_ID }}"
            },
            {
              "name": "text",
              "value": "=🧪 *AI Weekly Brief — {{ $now.format('YYYY-MM-DD') }} AEST*\\n\\n{{ $binary.data.toString().slice(0, 3500) }}\\n\\n_Full brief: media/TELLLEMTHATSME_COMMAND_CENTER.html → AI Research tab_"
            },
            {
              "name": "parse_mode",
              "value": "Markdown"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "post-telegram",
      "name": "POST to Telegram bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        440
      ],
      "notes": "Optional. Set TELEGRAM_BOT_TOKEN + TELEGRAM_AI_BRIEF_CHAT_ID in n8n env vars."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8888/api/feed/event",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "source",
              "value": "n8n-daily-brief"
            },
            {
              "name": "ts",
              "value": "={{ Date.now() }}"
            },
            {
              "name": "message",
              "value": "=📨 AI brief generated + posted to Discord{{ $env.TELEGRAM_BOT_TOKEN ? ' + Telegram' : '' }}"
            }
          ]
        },
        "options": {
          "timeout": 5000
        }
      },
      "id": "ping-karma-feed",
      "name": "Notify KARMA OS feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        240
      ],
      "notes": "Optional. Pushes a feed event so the KARMA OS dashboard shows the brief was delivered."
    }
  ],
  "connections": {
    "Cron · 06:00 AEST (= 20:00 UTC)": {
      "main": [
        [
          {
            "node": "Run youtube_researcher.py --trending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run youtube_researcher.py --trending": {
      "main": [
        [
          {
            "node": "Read the brief file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the brief file": {
      "main": [
        [
          {
            "node": "Build Discord payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Discord payload": {
      "main": [
        [
          {
            "node": "POST to Discord webhook",
            "type": "main",
            "index": 0
          },
          {
            "node": "POST to Telegram bot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST to Discord webhook": {
      "main": [
        [
          {
            "node": "Notify KARMA OS feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "karma-os"
    },
    {
      "name": "ai-research"
    },
    {
      "name": "daily"
    }
  ],
  "active": false,
  "versionId": "1.0.0",
  "meta": {
    "description": "Runs scripts/youtube_researcher.py --trending at 06:00 AEST daily, posts the brief to Discord (and optionally Telegram), and notifies the KARMA OS feed. Requires the n8n host to be on the same machine as KARMA OS (or have access to its file system via SSH / SMB).",
    "author": "tellemthatsme",
    "scheduleNote": "Cron is in UTC: '0 20 * * *' = 06:00 AEST. n8n does not auto-handle AEDT; AEST switches at 03:00 UTC on the first Sunday of April (AEDT starts) and 03:00 UTC on the first Sunday of October (AEST resumes). If you need AEST-vs-AEDT precision, swap the cron node for an n8n 'Wait' node with a Date input that the workflow writes based on the Australia/Sydney timezone."
  }
}
