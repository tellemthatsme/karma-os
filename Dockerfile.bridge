FROM python:3.12-alpine

WORKDIR /app

RUN apk add --no-cache chromium chromium-chromedriver

COPY browser_extension/requirements.txt* ./
RUN pip install --no-cache-dir flask flask-cors requests || true

COPY browser_extension/ ./browser_extension/

EXPOSE 9876

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:9876/status || exit 1

CMD ["python", "browser_extension/bridge_server.py"]
