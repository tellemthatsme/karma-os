{
  "name": "karma-os",
  "version": "1.0.0",
  "description": "KARMA OS \u2014 A cyberpunk-themed multi-dashboard system monitor with floating HUD, widget, and live desktop views",
  "main": "validate-karma.js",
  "scripts": {
    "test": "npx playwright test --project=chromium --reporter=list --workers=1",
    "test:ci": "npx playwright test --project=chromium --reporter=html",
    "test:hud": "npx playwright test karma-hud.spec.js --project=chromium --reporter=list --workers=1",
    "test:widget": "npx playwright test karma-widget.spec.js --project=chromium --reporter=list --workers=1",
    "test:desktop": "npx playwright test live-desktop.spec.js --project=chromium --reporter=list --workers=1",
    "test:regression": "npx playwright test karma-regression.spec.js --project=chromium --reporter=list --workers=1",
    "test:visual": "npx playwright test karma-visual.spec.js --project=chromium --reporter=list --workers=1",
    "validate": "node validate-karma.js",
    "server": "node server.js",
    "dev": "node server.js & npx playwright test --project=chromium --reporter=list --workers=1",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "launch": "cmd /c launch-karma.bat",
    "install:browsers": "npx playwright install chromium",
    "test:all": "npm run test:node && npm run test:e2e",
    "test:cross-browser": "npx playwright test --reporter=list",
    "test:node": "node --test karma-abtest.node-test.js server.test.js karma-integration.node-test.js",
    "test:e2e": "npx playwright test --project=chromium --reporter=list --workers=1",
    "env:check": "node scripts/verify-env.js"
  },
  "keywords": [
    "karma",
    "dashboard",
    "cyberpunk",
    "system-monitor",
    "hud",
    "widget",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "node-cron": "^4.5.0",
    "sqlite3": "^6.0.1",
    "ws": "^8.21.0"
  }
}
