# KARMA OS — environment variables
# Copy this to .env and fill in real values before running deploy-vps.sh

# --- Core ---
PORT=8888
GH_USER=tellemthatsme

# --- AI Research (server.js /api/chat + youtube_researcher.py) ---
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Push destinations (server.js /api/push/:platform) ---
# Discord webhook URL: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_AI_BRIEF=
# Telegram: @BotFather → /newbot, then message the bot to get chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_AI_BRIEF_CHAT_ID=
# Slack incoming webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_AI_BRIEF=

# --- n8n (only used with --profile full-stack) ---
N8N_BASIC_AUTH_USER=admin
N8N_PASSWORD=karma2026

# --- Bridge (browser_extension/bridge_server.py) ---
BRIDGE_TOKEN=please-change-me

# --- Caddy / TLS (deploy-vps.sh) ---
# Leave as _ to use the VPS IP directly. Set to your domain for Let's Encrypt.
KARMA_DOMAIN=_

# ── CI Override ────────────────────────────────────────────────────────────────────
SKIP_ENV_CHECK=1                # set to 1 to skip the .env presence check (for CI)


# --- TellLemThat'sMe YPP eligibility tracker (YouTube Data API v3, client-side in media/ypp.html) ---
# Get a free key at https://console.cloud.google.com/apis/library/youtube.googleapis.com (enable YouTube Data API v3).
# Saved into the browser localStorage by media/ypp.html (never transmitted off-device beyond the read-only YouTube API).
# YPP thresholds (per audit): 1,000 subscribers + 4,000 watch-hours OR 1,000 subs + 10M Shorts views.
YOUTUBE_API_KEY="google-cloud-youtube-data-api-v3-key-here"
YOUTUBE_CHANNEL_ID="UCxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional override for Day 1 of 16-track roll-out (default 2026-06-08 per launch/SESSION_LOG.md).
YPP_DAY1_DATE="2026-06-08"
