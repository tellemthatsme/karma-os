#!/bin/bash
# Pre-commit hook: run node --check on inline scripts in changed .html files
# Catches SyntaxError regressions like the unescaped apostrophe and
# top-level await bugs we fixed in commits 67fb6e0 and 8563037.
#
# Install: git config core.hooksPath .githooks
set -e
changed=$(git diff --cached --name-only --diff-filter=ACM | grep '\.html$' || true)
if [ -z "$changed" ]; then
  exit 0
fi
failed=0
for f in $changed; do
  python -X utf8 -c "
import re, sys, subprocess
try:
    html = open(r'$f', encoding='utf-8').read()
    scripts = re.findall(r'<script[^>]*>(.*?)</script>', html, re.S)
    if not scripts: sys.exit(0)
    largest = max(scripts, key=len)
    open('/tmp/_precommit_check.js', 'w', encoding='utf-8').write(largest)
    r = subprocess.run(['node', '--check', '/tmp/_precommit_check.js'], capture_output=True, text=True)
    if r.returncode != 0:
        print(f'  SyntaxError in $f:')
        print(r.stderr[:500])
        sys.exit(1)
    print(f'  ok: $f')
except Exception as e:
    print(f'  skipped: $f ({e})')
" || failed=1
done
if [ $failed -ne 0 ]; then
  echo ''
  echo 'Commit blocked: fix SyntaxErrors before committing.'
  exit 1
fi
exit 0
